{
  "version": "2.17",
  "children": [
    {
      "type": "frame",
      "id": "It029",
      "name": "/items/[id] - ideal state(1920px)",
      "x": 0,
      "y": 0,
      "clip": true,
      "width": 1920,
      "height": 1080,
      "fill": "$lib:background",
      "children": [
        {
          "id": "It027",
          "type": "ref",
          "ref": "lib:Z36Vk8",
          "name": "Sidebar",
          "height": 1080
        },
        {
          "type": "frame",
          "id": "It028",
          "name": "Contents",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "children": [
            {
              "type": "frame",
              "id": "It010",
              "name": "Toolbar",
              "width": "fill_container",
              "fill": "$lib:surface",
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "It008",
                  "name": "Toolbar Bar",
                  "width": "fill_container",
                  "padding": [
                    "$lib:getSpace(1)",
                    "$lib:getSpace(2)"
                  ],
                  "justifyContent": "space_between",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "It004",
                      "name": "File Path",
                      "gap": "$lib:getSpace(1/2)",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "It001",
                          "name": "Path",
                          "fill": "$lib:high-emphasis-text",
                          "content": "articles/my-article.md",
                          "lineHeight": "$lib:text-body2-line-height",
                          "fontFamily": "$lib:font-sans",
                          "fontSize": "$lib:text-body2",
                          "fontWeight": "$lib:fontWeight-normal"
                        },
                        {
                          "type": "frame",
                          "id": "It003",
                          "name": "Copy Button",
                          "width": 24,
                          "height": 24,
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "It002",
                              "name": "Icon",
                              "width": 16,
                              "height": 16,
                              "icon": "content_copy",
                              "library": "Material Symbols Outlined",
                              "weight": 500,
                              "fill": "$lib:high-emphasis-text"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "It007",
                      "name": "Publish Button（実装 headerButtonStyle は padding 4/16 + border 2px が padding の外。pen の stroke は strokeAlignment inner でレイアウトに寄与しないため padding を 6/18 にして寸法を合わせた）",
                      "fill": "$lib:surface",
                      "cornerRadius": 8,
                      "stroke": "$lib:green-60",
                      "strokeWidth": 2,
                      "strokeAlignment": "inner",
                      "gap": "$lib:getSpace(1/2)",
                      "padding": [
                        6,
                        18
                      ],
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "It005",
                          "name": "Label",
                          "fill": "$lib:green-text",
                          "content": "記事を投稿する",
                          "lineHeight": "$lib:text-body2-dense-line-height",
                          "fontFamily": "$lib:font-sans",
                          "fontSize": "$lib:text-body2",
                          "fontWeight": "$lib:fontWeight-semibold"
                        },
                        {
                          "type": "icon",
                          "id": "It006",
                          "name": "Icon",
                          "width": 16,
                          "height": 16,
                          "icon": "publish",
                          "library": "Material Symbols Outlined",
                          "weight": 500,
                          "fill": "$lib:green-text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "rectangle",
                  "id": "It009",
                  "name": "Toolbar Rule",
                  "fill": "$lib:divider",
                  "width": "fill_container",
                  "height": 1
                }
              ]
            },
            {
              "type": "frame",
              "id": "It026",
              "name": "Contents Wrapper (実装 contentsWrapperStyle: margin 16/16/0)",
              "width": "fill_container",
              "padding": [
                "$lib:getSpace(2)",
                "$lib:getSpace(2)",
                0,
                "$lib:getSpace(2)"
              ],
              "justifyContent": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "It025",
                  "name": "Card (実装 contentsContainerStyle: maxWidth 820 / radius 8 / padding 24)",
                  "width": 820,
                  "fill": "$lib:surface",
                  "cornerRadius": 8,
                  "layout": "vertical",
                  "gap": "$lib:getSpace(3)",
                  "padding": "$lib:getSpace(3)",

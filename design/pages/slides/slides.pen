                    },
                    {
                      "type": "frame",
                      "id": "N3tg9B",
                      "name": "MarpSlideFrame",
                      "context": "qiita-cli の Preview では src/client/components/MarpSlideViewer/index.tsx が aspect-ratio 16/9 の Shadow DOM に Marp の CSS と SVG をそのまま流し込む。中身は SVG ごと等比スケールされるので、375px では文字も比例して小さくなる。ここに置いてあるのは寸法と代表的な中身で、フォントサイズはトークンの下限に丸めてある スライドの中身（タイトル・本文）のフォントサイズと太さは代表値。Marp のテーマ CSS は Shadow DOM に流し込まれるので qiita-cli のトークン（`Weight.bold` = 600）とは無関係で、リポジトリに `*.css` が無いため実際の値は確認できない。 行送り（lineHeight）も同じく代表値で、実装側は `LineHeight.subhead` を1箇所も使っていないので不一致ではないが、Marp のテーマ CSS が読めないので裏付けは取れない。 プレビュー側のスライドは各 Page の ref に 1px の枠（$lib:divider）を付けている。実装 MarpSlideViewer/index.tsx の pageStyle は boxShadow だが、影を止めて枠にしたいという指摘を受けて差し替えた提案。プレゼンモード（?present=1）は全画面なので枠を付けていない。",
                      "reusable": true,
                      "clip": true,
                      "width": 480,
                      "height": 270,
                      "fill": "$lib:gray-0",
                      "layout": "vertical",
                      "gap": "$lib:getSpace(2)",
                      "padding": [
                        "$lib:getSpace(4)",
                        "$lib:getSpace(5)"
                      ],
                      "justifyContent": "center",
